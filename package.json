{
  "name": "convex-invite",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:example": "bun run --cwd apps/example convex:dev",
    "dev:web": "bun run --cwd apps/web dev",
    "format": "biome format --write .",
    "lint": "turbo run lint && biome check .",
    "release:check": "bun run check && bun run verify:package && bun audit --audit-level=high && bun scripts/check-release.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "verify:package": "bun scripts/verify-package.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "turbo": "2.10.9",
    "typescript": "7.0.2"
  }
}
